{
  "manifest_version": 3,
  "name": "Liquidador — lectura de obligación DIAN",
  "version": "1.0.0",
  "description": "Lee la obligación financiera abierta en DIAN solo al pulsar Importar web - PDF en el liquidador.",
  "permissions": ["scripting"],
  "host_permissions": ["https://muisca.dian.gov.co/WebRecaudacion/DefConsultaObligacion.faces*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "content_scripts": [{
    "matches": ["https://liquidador-de-obligaciones-tributarias.onrender.com/liquidacion.html*", "https://liquidador-de-obligaciones-tributarias.onrender.com/titulos.html*"],
    "js": ["puente.js"], "run_at": "document_start"
  }]
}
